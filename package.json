{
  "name": "nathanhuh.github.io",
  "version": "0.1.0",
  "description": "This repository contains the source code for Nathan Huh's personal website.",
  "main": "index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('_site', { recursive: true, force: true })\"",
    "build:css": "postcss ./src/style.css -o ./_site/style.css",
    "watch:css": "postcss ./src/style.css -o ./_site/style.css --watch",
    "build:eleventy": "eleventy",
    "watch:eleventy": "eleventy --serve",
    "build": "npm-run-all clean build:css build:eleventy",
    "prestart": "npm run clean",
    "start": "npm-run-all --parallel watch:css watch:eleventy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@tailwindcss/postcss": "^4.3.4",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.32",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.3.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
