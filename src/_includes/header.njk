{% set navigation = [
    { url: "/", label: "Home" },
    { url: "/personalProjects/", label: "Projects" },
    { url: "/blog/", label: "Writing" },
    { url: "/profile/", label: "About" }
] %}
<header class="shell">
    <nav class="masthead" aria-label="Main navigation">
        <a class="wordmark" href="/">Nathan Huh</a>
        <ul class="nav-links">
            {% for item in navigation %}
            {% set active = page.url == item.url or (item.url == "/blog/" and page.url and page.url.indexOf("/blog/") == 0) %}
            <li>
                <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% elif active %} aria-current="location"{% endif %}>{{ item.label }}</a>
            </li>
            {% endfor %}
        </ul>
        <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" title="Toggle dark mode" hidden>
            <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5"/>
            </svg>
            <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 13.4A9 9 0 0 1 10.6 3 9 9 0 1 0 21 13.4Z"/>
            </svg>
        </button>
    </nav>
</header>
