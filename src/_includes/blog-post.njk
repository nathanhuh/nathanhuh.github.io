---
layout: base.njk
---

<article class="shell interior">
    <header class="page-heading">
        <h1>{{ title }}</h1>
        {% set postDate = date %}
        {% set postTags = tags %}
        {% include "post-meta.njk" %}
    </header>

    <div class="prose post-content reading-width">
        {{ content | safe }}
    </div>

    <footer class="post-footer reading-width">
        <a class="text-link" href="/blog/"><span aria-hidden="true">←</span> All writing</a>
    </footer>
</article>
