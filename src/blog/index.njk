---
layout: base.njk
title: Writing - Nathan Huh
description: Thoughts, experiences, and technical insights on software engineering, SRE, and infrastructure.
---

<section class="shell interior">
    <header class="page-heading">
        <h1>Writing</h1>
        <p class="muted">{{ description }}</p>
    </header>

    <div class="post-list">
        {% set posts = collections.blog | reverse %}
        {% for post in posts %}
        <article>
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            {% set postDate = post.data.date %}
            {% set postTags = post.data.tags %}
            {% include "post-meta.njk" %}
            {% if post.data.description %}<p class="muted">{{ post.data.description }}</p>{% endif %}
            <a class="text-link" href="{{ post.url }}">Read more <span aria-hidden="true">↗</span></a>
        </article>
        {% else %}
        <p class="muted">No blog posts yet. Check back soon!</p>
        {% endfor %}
    </div>
</section>
